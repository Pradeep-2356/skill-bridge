{
  "name": "skillbridge",
  "version": "1.0.0",
  "private": true,
  "description": "SkillBridge – peer-to-peer micro-learning platform (MERN monorepo)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @skillbridge/server",
    "dev:client": "npm run dev -w @skillbridge/client",
    "dev:https": "HTTPS=true COOKIE_SECURE=true npm run dev",
    "build": "npm run build -w @skillbridge/client",
    "start": "NODE_ENV=production node apps/server/src/server.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:client",
    "test:unit": "npm run test -w @skillbridge/shared && npm run test:unit -w @skillbridge/server",
    "test:integration": "npm run test:integration -w @skillbridge/server",
    "test:client": "npm run test -w @skillbridge/client",
    "test:e2e": "playwright test",
    "test:coverage": "npm run test:coverage -w @skillbridge/server && npm run test:coverage -w @skillbridge/client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset-db.js",
    "create-admin": "node scripts/create-admin.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
