# SkillBridge configuration. `npm run setup` copies this file to .env and fills in a secret.
# Never commit .env. No AWS keys or paid services are needed.

NODE_ENV=development
PORT=5000
# The browser origin allowed by CORS (comma-separate several).
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Community running locally (brew services start mongodb-community)
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge_dev

# Signs access tokens. At least 32 characters. `npm run setup` generates one.
JWT_ACCESS_SECRET=replace-me-run-npm-run-setup
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_COST=12

# true under `npm run dev:https` (set automatically by that script)
COOKIE_SECURE=false
HTTPS=false
SSL_CERT_PATH=certs/localhost.pem
SSL_KEY_PATH=certs/localhost-key.pem

# Email: smtp → Mailpit on localhost:1025 (falls back to printing in the terminal)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=SkillBridge <no-reply@skillbridge.test>

# Profile photos are stored on disk here (relative to the repository root)
UPLOAD_DIR=apps/server/uploads
MAX_AVATAR_MB=2

# Password for every account created by `npm run db:seed`
SEED_DEMO_PASSWORD=Demo@1234

# Sprint 2 – local matching queue and background jobs (no AWS needed)
# How often the in-process worker checks the queue, and how often old requests are expired
MATCH_WORKER_INTERVAL_MS=1000
EXPIRY_JOB_INTERVAL_MS=60000
# Copies SQS behaviour: a message is hidden for this long while being processed,
# and moves to the dead-letter state after this many receives
QUEUE_VISIBILITY_SECONDS=30
QUEUE_MAX_RECEIVES=3
# Demo switch: share of matching attempts that fail on purpose so Retry can be shown (0 = never, 1 = always)
MATCH_FAILURE_RATE=0
